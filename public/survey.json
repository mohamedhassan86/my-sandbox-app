{
  "surveyId": "SV001",
  "title": "Customer Feedback Survey",
  "description": "We value your opinion. Please share your experience with us.",
  "version": "1.0",
  "pages": [
    {
      "pageId": "P1",
      "title": "About You",
      "questions": [
        {
          "questionId": "Q1",
          "type": "textbox",
          "label": "Your name",
          "required": true,
          "minLength": 2,
          "maxLength": 80,
          "attachmentsRequired": 0
        },
        {
          "questionId": "Q2",
          "type": "textbox",
          "label": "Email address",
          "required": true,
          "minLength": 5,
          "maxLength": 120,
          "attachmentsRequired": 0
        },
        {
          "questionId": "Q3",
          "type": "radio",
          "label": "How did you hear about us?",
          "required": true,
          "options": [
            { "label": "Social media", "value": "social" },
            { "label": "Friend or colleague", "value": "referral" },
            { "label": "Search engine", "value": "search" },
            { "label": "Advertisement", "value": "ad" },
            { "label": "Other", "value": "other" }
          ],
          "attachmentsRequired": 0
        },
        {
          "questionId": "Q3b",
          "type": "toggle_button",
          "label": "Enable Notifications",
          "description": "Receive email updates about your submission.",
          "defaultValue": false,
          "required": false,
          "attachmentsRequired": 0,
          "options": { "onLabel": "Enabled", "offLabel": "Disabled" }
        }
      ]
    },
    {
      "pageId": "P2",
      "title": "Your Experience",
      "questions": [
        {
          "questionId": "Q4",
          "type": "satisfaction",
          "label": "Are you satisfied with our service?",
          "required": true,
          "options": [
            { "label": "Very satisfied", "value": "very-satisfied", "icon": "😊" },
            { "label": "Satisfied", "value": "satisfied", "icon": "🙂" },
            { "label": "Neutral", "value": "neutral", "icon": "😐" },
            { "label": "Unsatisfied", "value": "unsatisfied", "icon": "🙁" },
            { "label": "Very unsatisfied", "value": "very-unsatisfied", "icon": "😞" }
          ],
          "attachmentsRequired": 0
        },
        {
          "questionId": "Q4b",
          "type": "rating",
          "label": "How likely are you to recommend us?",
          "required": true,
          "minValue": 1,
          "maxValue": 10,
          "leftLabel": "Not at all likely",
          "rightLabel": "Extremely likely",
          "attachmentsRequired": 0
        },
        {
          "questionId": "Q5",
          "type": "checkbox",
          "label": "Which topics matter to you?",
          "required": false,
          "options": [
            { "label": "Product quality", "value": "quality" },
            { "label": "Customer support", "value": "support" },
            { "label": "Pricing", "value": "pricing" },
            { "label": "Shipping", "value": "shipping" },
            { "label": "Returns", "value": "returns" }
          ],
          "attachmentsRequired": 0
        },
        {
          "questionId": "Q6",
          "type": "textarea",
          "label": "Tell us more about your experience",
          "required": false,
          "maxLength": 1000,
          "attachmentsRequired": 0
        }
      ]
    },
    {
      "pageId": "P3",
      "title": "Supporting Files",
      "questions": [
        {
          "questionId": "Q7",
          "type": "radio",
          "label": "Would you like to share supporting files?",
          "required": true,
          "options": [
            { "label": "Yes, I have files to share", "value": "yes" },
            { "label": "No, not at this time", "value": "no" }
          ],
          "attachmentsRequired": 0
        },
        {
          "questionId": "Q8",
          "type": "textarea",
          "label": "Upload relevant screenshots or documents below",
          "required": false,
          "maxLength": 200,
          "attachmentsRequired": 3,
          "acceptedFileTypes": ["image/png", "image/jpeg", "application/pdf"],
          "maxFileSizeBytes": 5242880
        }
      ]
    },
    {
      "pageId": "P4",
      "title": "Final Thoughts",
      "questions": [
        {
          "questionId": "Q9",
          "type": "textarea",
          "label": "What could we improve?",
          "required": false,
          "maxLength": 500,
          "attachmentsRequired": 0
        },
        {
          "questionId": "Q10",
          "type": "radio",
          "label": "May we follow up with you?",
          "required": true,
          "options": [
            { "label": "Yes, please contact me", "value": "yes" },
            { "label": "No, thanks", "value": "no" }
          ],
          "attachmentsRequired": 0
        }
      ]
    }
  ]
}
